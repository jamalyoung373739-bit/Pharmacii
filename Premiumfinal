-- [[ CONFIG ]] --
local WHITELIST_URL = "https://raw.githubusercontent.com/jamalyoung373739-bit/whitelist.json/main/json"
local HUB_URL = "https://raw.githubusercontent.com/jamalyoung373739-bit/Pharmacii-Hub/main/Pharmacii"

local hwid = (gethwid and gethwid()) or (game:GetService("RbxAnalyticsService"):GetClientId())
local HttpService = game:GetService("HttpService")

print("PHARMACII: Starting Authentication...")

local function Authenticate()
    local success, response = pcall(function()
        return game:HttpGet(WHITELIST_URL .. "?t=" .. os.time())
    end)

    if success then
        -- This is the magic part: It turns the text ["ID"] into a Lua table
        local whitelist = HttpService:JSONDecode(response)
        local isWhitelisted = false

        -- Check every ID in your GitHub list
        for _, id in pairs(whitelist) do
            if id == hwid then
                isWhitelisted = true
                break
            end
        end

        if isWhitelisted then
            print("PHARMACII: ID Verified! Loading Hub...")
            local hubSuccess, hubCode = pcall(function()
                return game:HttpGet(HUB_URL .. "?t=" .. os.time())
            end)
            
            if hubSuccess then
                loadstring(hubCode)()
            else
                warn("PHARMACII: Hub URL is broken or repo is private.")
            end
        else
            warn("PHARMACII: Access Denied.")
            print("Your ID was not found in the whitelist table.")
            if setclipboard then setclipboard(hwid) end
        end
    else
        warn("PHARMACII: Connection Error.")
    end
end

task.spawn(Authenticate)
